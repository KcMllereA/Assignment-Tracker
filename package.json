{
    "name": "assignment-tracker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:github": "vite --mode github",
        "dev:utcs": "vite --mode utcs",
        "build:github": "vite build --mode github --outDir dist-github",
        "build:utcs": "vite build --mode utcs --outDir dist-utcs",
        "deploy:utcs": "npm run build:utcs && node --env-file=.env.utcs scripts/deploy-utcs.js",
        "deploy:github": "npm run build:github && gh-pages -d dist-github",
        "deploy": "npm run deploy:github && npm run deploy:utcs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "gh-pages": "^6.3.0",
        "globals": "^17.13.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
